<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>{{name}}</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>{{name}}</name>
    <description>Spring AI agent on Amazon Bedrock AgentCore Runtime</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <spring-ai-agentcore.version>2.1.0</spring-ai-agentcore.version>
        <aws-sdk.version>2.54.13</aws-sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springaicommunity</groupId>
                <artifactId>spring-ai-agentcore-bom</artifactId>
                <version>${spring-ai-agentcore.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

{{#if (eq modelProvider "Bedrock")}}
        <!-- Bedrock Converse chat model -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-bedrock-converse</artifactId>
        </dependency>
{{/if}}
{{#if (eq modelProvider "OpenAI")}}
        <!-- OpenAI chat model (API key from the AgentCore credential env var; version from spring-ai-bom) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
{{/if}}
{{#if (eq modelProvider "Anthropic")}}
        <!-- Anthropic (Claude) chat model (API key from the AgentCore credential env var; version from spring-ai-bom) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
        </dependency>
{{/if}}
{{#if (eq modelProvider "Gemini")}}
        <!-- Google Gemini chat model — Gemini Developer API (API key from the AgentCore credential env var; version from spring-ai-bom) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-google-genai</artifactId>
        </dependency>
{{/if}}

        <!-- AgentCore Runtime contract (/invocations + /ping, SSE, @AgentCoreInvocation) -->
        <dependency>
            <groupId>org.springaicommunity</groupId>
            <artifactId>spring-ai-agentcore-runtime-starter</artifactId>
        </dependency>
{{#if hasMemory}}

        <!-- AgentCore short- + long-term memory. The auto-configuration self-gates on
             agentcore.memory.memory-id, so it stays inert until the runtime injects MEMORY_<NAME>_ID. -->
        <dependency>
            <groupId>org.springaicommunity</groupId>
            <artifactId>spring-ai-agentcore-memory</artifactId>
        </dependency>
{{/if}}
{{#if hasGateway}}

        <!-- AgentCore Gateway tools over MCP (streamable HTTP). The MCP client is disabled by default
             and enabled per-gateway by GatewayEnvironmentPostProcessor only when the gateway URL env
             var is injected at deploy, so it stays inert locally. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-autoconfigure-mcp-client-common</artifactId>
        </dependency>
        <!-- SigV4 signing for AWS_IAM gateways (McpConfig). -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>auth</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>http-auth-aws</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>regions</artifactId>
        </dependency>
{{/if}}
{{#if hasCodeInterpreter}}

        <!-- AgentCore code interpreter (sandboxed code execution). The autoconfiguration exposes a
             ToolCallbackProvider that the base ChatService picks up automatically; the underlying
             BedrockAgentCoreClient is lazy, so the app boots inert until the tool is first invoked. -->
        <dependency>
            <groupId>org.springaicommunity</groupId>
            <artifactId>spring-ai-agentcore-code-interpreter</artifactId>
        </dependency>
{{/if}}
{{#if hasBrowser}}

        <!-- AgentCore browser (agentcore mode: the AWS-managed remote browser, driven over CDP — no
             local Chromium). The autoconfiguration exposes a ToolCallbackProvider the base ChatService
             picks up automatically; the Playwright bean is lazy, so the app boots inert until the tool
             is first invoked. Transitively pulls com.microsoft.playwright (client only in this mode). -->
        <dependency>
            <groupId>org.springaicommunity</groupId>
            <artifactId>spring-ai-agentcore-browser</artifactId>
        </dependency>
{{/if}}

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
